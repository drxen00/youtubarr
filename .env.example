# Copy to .env for local development. In Docker, set these in docker-compose.yml / the Unraid template.

# Required for indexing channels. Create at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first). Can also be set later from the Settings page.
YOUTUBE_API_KEY=

# Optional. When set, the UI requires this password (single-user). Strongly recommended if you
# expose the app through a Cloudflare tunnel without Cloudflare Access in front of it.
APP_PASSWORD=

# Where the SQLite database lives (directory). Mount this as a volume.
DATA_DIR=./data

# Where yt-dlp downloads go (directory). Mount this as a volume on a big share.
MEDIA_DIR=./media

# HTTP port
PORT=8790
